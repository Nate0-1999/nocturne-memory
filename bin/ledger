#!/usr/bin/env python3
"""M3LM: feature coverage from data, evidence, and Git (SPEC B.6 / D.2 154).

The .yaml source uses JSON-compatible YAML so this command needs only Python.
Paths in surfaces are workspace-relative files or directory prefixes ending /.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

GARDEN = Path(__file__).resolve().parents[1]
WORKSPACE = GARDEN.parent
FROZEN = (GARDEN / "docs/feature-ledger.yaml").is_file()
SOURCE = GARDEN / ("docs/feature-ledger.yaml" if FROZEN else "notes/feature-ledger.yaml")
STATUSES = {"built", "partial", "not built", "horizon", "dropped", "unverified"}
DISCRETION = (
    "A screenshot proves the walk ran, not that it shows the claim. "
    "The reviewer judges the visible claim and source mapping; rendered-state "
    "assertions grow row by row in the agent tests. No-feature-impact reasons "
    "are declarations for review, not proof."
)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_json(path):
    return json.loads(path.read_text(encoding="utf-8"))


def repository(name):
    if FROZEN and name == read_json(GARDEN / "docs/frozen-law.json")["repository"]:
        return GARDEN
    return WORKSPACE / name


def git(repo, *args):
    return subprocess.check_output(
        ["git", "-C", str(repo), *args], stderr=subprocess.PIPE
    ).decode()


def safe_path(value):
    return (
        isinstance(value, str)
        and bool(value)
        and not Path(value).is_absolute()
        and ".." not in Path(value).parts
    )


def matches(path, surface):
    return path.startswith(surface) if surface.endswith("/") else path == surface


def load_ledger():
    data = read_json(SOURCE)
    errors, seen = [], set()
    if data.get("version") != 1 or not data.get("rows"):
        raise ValueError("ledger needs version 1 and nonempty rows")
    for row in data["rows"]:
        key = row.get("id", "")
        if not re.fullmatch(r"FL-\d{3,}", key) or key in seen:
            errors.append(f"invalid or duplicate id: {key}")
        seen.add(key)
        for field in ("label", "owner", "section", "era"):
            if not isinstance(row.get(field), str) or not row[field].strip():
                errors.append(f"{key}: missing {field}")
        if row.get("status") not in STATUSES:
            errors.append(f"{key}: invalid status")
        surfaces = row.get("surfaces")
        if not isinstance(surfaces, list) or any(
            not safe_path(p) or p.split("/")[0] not in {"garden", "harness", "spine"}
            for p in surfaces
        ):
            errors.append(f"{key}: surfaces must be workspace-relative paths")
        if row.get("status") in {"built", "partial"}:
            if not isinstance(row.get("walk"), str) or not row["walk"].strip():
                errors.append(f"{key}: built/partial row needs a walk")
            if not surfaces:
                errors.append(f"{key}: built/partial row needs surfaces")
    if errors:
        raise ValueError("\n".join(errors))
    return data


def render(data):
    lines = [
        "# The Feature Ledger",
        "",
        "<!-- Generated by bin/ledger render; edit feature-ledger.yaml. -->",
        "",
        data["introduction"],
        "",
    ]
    section = None
    for row in data["rows"]:
        if row["section"] != section:
            section = row["section"]
            lines.extend([f"## {section}", ""])
        lines.extend(
            [
                f"- **{row['id']}** [{row['era']}] {row['label']} ‖ {row['status']} ‖ {row['walk']} ‖ {row['owner']}",
                "  - Surfaces: "
                + (", ".join(f"`{p}`" for p in row["surfaces"]) or "not implemented"),
            ]
        )
    return "\n".join(line.rstrip() for line in "\n".join(lines).splitlines()) + "\n"


def resolve_diff(value, repo_name=None):
    if "=" in value:
        repo_name, value = value.split("=", 1)
    if value.count("..") != 1 or "..." in value:
        raise ValueError("use [harness|spine|garden=]<base>..<head>")
    base, head = value.split("..")
    if not base or not head or base.startswith("-") or head.startswith("-"):
        raise ValueError("diff needs explicit base and head revisions")
    names = [repo_name] if repo_name else ["harness", "spine", "garden"]
    found = []
    for name in names:
        if name not in {"harness", "spine", "garden"}:
            raise ValueError(f"unknown repository: {name}")
        try:
            revisions = [
                git(
                    repository(name), "rev-parse", "--verify", f"{ref}^{{commit}}"
                ).strip()
                for ref in (base, head)
            ]
            found.append({"repo": name, "base": revisions[0], "head": revisions[1]})
        except subprocess.CalledProcessError:
            continue
    if len(found) != 1:
        raise ValueError(
            "diff repository is absent or ambiguous; specify --repo or repo=range"
        )
    return found[0]


def impact(data, diffs, paths=()):
    changed = set(paths)
    if any(
        not safe_path(p) or p.split("/")[0] not in {"garden", "harness", "spine"}
        for p in changed
    ):
        raise ValueError(
            "paths must be workspace-relative: garden/, harness/ or spine/"
        )
    for diff in diffs:
        changed.update(diff.get("packet_paths", []))
        # No rename collapsing: both the removed and added paths affect consumers.
        paths = git(
            repository(diff["repo"]),
            "diff",
            "--name-only",
            "--no-renames",
            "-z",
            diff["base"],
            diff["head"],
            "--",
        ).split("\0")
        changed.update(f"{diff['repo']}/{path}" for path in paths if path)
    affected = {
        row["id"]: sorted(
            path
            for path in changed
            if any(matches(path, p) or matches(p, path) for p in row["surfaces"])
        )
        for row in data["rows"]
    }
    affected = {key: paths for key, paths in affected.items() if paths}
    mapped = {path for paths in affected.values() for path in paths}
    # Protected rows first (v2.115): the settled features lead every list.
    required = [
        row["id"]
        for row in sorted(data["rows"], key=lambda r: not r.get("protected"))
        if row["status"] in {"built", "partial"} and row["id"] in affected
    ]
    return {
        "diffs": diffs,
        "affected": affected,
        "required": required,
        "protected": [r["id"] for r in data["rows"] if r.get("protected") and r["id"] in affected],
        "unmapped": sorted(changed - mapped),
    }


def added_rows(data, diffs):
    added = set()
    for diff in diffs:
        if diff["repo"] == "garden":
            previous = json.loads(
                git(GARDEN, "show", f"{diff['base']}:notes/feature-ledger.yaml")
            )
            added.update(
                {r["id"] for r in data["rows"] if r["status"] in {"built", "partial"}}
                - {
                    r["id"]
                    for r in previous["rows"]
                    if r["status"] in {"built", "partial"}
                }
            )
    return added


def report(data, packet, diffs):
    result = impact(data, diffs)
    required = (
        set(result["required"]) | added_rows(data, diffs)
        if diffs
        else {
            row["id"] for row in data["rows"] if row["status"] in {"built", "partial"}
        }
    )
    return {
        "packet": packet.upper(),
        "mode": "builder" if diffs else "scout",
        "discretion": DISCRETION,
        "ledger_sha256": digest(SOURCE),
        "diffs": diffs,
        "unmapped": {path: "" for path in result["unmapped"]},
        "unmapped_instruction": "add a row or declare no feature impact (give a reason for each path)",
        "rows": {
            row["id"]: {
                "label": row["label"],
                "walk": row["walk"],
                "protected": bool(row.get("protected")),
                "verdict": "",
                "screenshot": f"{row['id']}.png",
                "flag": "",
                "observed": "",
            }
            for row in sorted(data["rows"], key=lambda r: not r.get("protected"))
            if row["id"] in required
        },
        "not_run": {
            row["id"]: row["status"]
            if row["status"] not in {"built", "partial"}
            else "outside diff"
            for row in data["rows"]
            if row["id"] not in required
        },
    }


def same_syntax(repo, base, head, path):
    """True when a Python file's syntax tree is unchanged (docstring whitespace ignored)."""

    import ast

    def normalized(rev):
        tree = ast.parse(git(repo, "show", f"{rev}:{path}"))
        for node in ast.walk(tree):
            body = getattr(node, "body", None)
            if (
                isinstance(body, list)
                and body
                and isinstance(body[0], ast.Expr)
                and isinstance(getattr(body[0], "value", None), ast.Constant)
                and isinstance(body[0].value.value, str)
            ):
                body[0].value.value = " ".join(body[0].value.value.split())
        return ast.dump(tree)

    try:
        return path.endswith(".py") and normalized(base) == normalized(head)
    except (subprocess.CalledProcessError, SyntaxError, ValueError):
        return False


def verify(data, directory, check_diffs=()):
    directory = directory.resolve()
    errors = []
    if directory.parent.name != "verification":
        errors.append("evidence must live in verification/<packet>/")
    try:
        evidence = read_json(directory / "ledger-report.json")
    except (OSError, ValueError) as exc:
        evidence = {}
        errors.append(f"missing or invalid ledger-report.json: {exc}")
    diffs = evidence.get("diffs", list(check_diffs))
    mode = evidence.get("mode", "builder" if check_diffs else "scout")
    if mode not in {"scout", "builder"} or (mode == "builder" and not diffs):
        errors.append(
            "builder report needs its packet diffs; scout covers the full ledger"
        )
    resolved = [resolve_diff(f"{d['repo']}={d['base']}..{d['head']}") for d in diffs]
    if len({d["repo"] for d in resolved}) != len(resolved):
        errors.append("use one complete packet diff per repository")
    expected = report(data, directory.name, resolved if mode == "builder" else [])
    if check_diffs:
        # M3IB: CI computes the pushed changes independently of the author's report.
        checked = report(data, directory.name, check_diffs)
        expected["rows"].update(checked["rows"])
        expected["unmapped"].update(checked["unmapped"])
    if evidence.get("packet", "").lower() != directory.name.lower():
        errors.append("report packet must match its evidence folder")
    if evidence.get("ledger_sha256") != digest(SOURCE):
        errors.append("ledger changed: regenerate the report and review required rows")
    if evidence.get("discretion") != DISCRETION:
        errors.append("report header must name the remaining reviewer discretion")
    actual = evidence.get("rows", {})
    extras = set(actual) - set(expected["rows"])
    if extras:
        errors.append("rows outside required coverage: " + ", ".join(sorted(extras)))
    unmapped = evidence.get("unmapped", {})
    for path in expected["unmapped"]:
        if not isinstance(unmapped.get(path), str) or not unmapped[path].strip():
            errors.append(f"{path}: add a row or declare no feature impact")
    sums = {}
    try:
        for line in (directory / "SHA256SUMS").read_text().splitlines():
            checksum, filename = line.split(maxsplit=1)
            sums[filename.lstrip("*").removeprefix("./")] = checksum
    except (OSError, ValueError):
        errors.append("missing or malformed SHA256SUMS")
    report_path = directory / "ledger-report.json"
    if report_path.is_file() and sums.get(report_path.name) != digest(report_path):
        errors.append("ledger-report.json: missing or mismatched SHA256SUMS entry")
    old_images = set()
    for diff in resolved:
        repo = repository(diff["repo"])
        for line in git(
            repo, "ls-tree", "-r", diff["base"], "--", "verification"
        ).splitlines():
            meta, path = line.split("\t", 1)
            if Path(path).suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}:
                old_images.add(meta.split()[2])
        surfaces = [
            p.removeprefix(diff["repo"] + "/")
            for row in data["rows"]
            if row["id"] in expected["rows"]
            for p in row["surfaces"]
            if p.startswith(diff["repo"] + "/")
        ]
        drift = (
            git(repo, "diff", "--name-only", diff["head"], "--", *surfaces).strip()
            if surfaces
            else ""
        )
        if drift:
            errors.append(
                f"{diff['repo']}: mapped surfaces changed after report head: {drift}"
            )
    flags = " ".join(read_json(GARDEN / "docs/frozen-law.json")["flag_ids"]) if FROZEN else (
        (GARDEN / "FLAGS.md").read_text()
        + "\n"
        + "\n".join(
            p.read_text() for p in (GARDEN / "notes/archive").glob("*flags*.md")
        )
    )
    syntax_checks = [
        (diff, impact(data, [diff])["affected"])
        for diff in [*resolved, *check_diffs]
    ]
    for key in expected["rows"]:
        item = actual.get(key, {})
        problems = []
        if item.get("verdict") == "UNCHANGED":
            # F099 ruling: a formatting-only change proves itself by syntax-tree
            # equality on every path that made the row required; no walk, no
            # screenshot. Anything else under this verdict is refused here.
            paths = [
                (diff, path)
                for diff, affected in syntax_checks
                for path in affected.get(key, [])
            ]
            same = bool(paths) and all(
                same_syntax(
                    repository(diff["repo"]),
                    diff["base"],
                    diff["head"],
                    path.removeprefix(diff["repo"] + "/"),
                )
                for diff, path in paths
            )
            if not same:
                problems.append(
                    "UNCHANGED needs syntax-tree equality on every affected Python path"
                )
            if problems:
                errors.append(f"{key}: " + "; ".join(problems))
            continue
        if item.get("verdict") not in {"PASS", "FAIL"}:
            problems.append("needs PASS, FAIL or UNCHANGED")
        if item.get("verdict") == "FAIL" and not (
            re.fullmatch(r"F\d{3,}", item.get("flag", ""))
            and re.search(r"\b" + re.escape(item["flag"]) + r"\b", flags)
        ):
            problems.append("FAIL needs an existing flag")
        filename = item.get("screenshot", f"{key}.png")
        path = directory / filename
        if (
            not safe_path(filename)
            or Path(filename).name != filename
            or Path(filename).stem != key
            or path.suffix.lower() not in {".png", ".jpg", ".jpeg", ".webp"}
        ):
            problems.append(
                "screenshot must be named by row id inside this evidence folder"
            )
        elif not path.is_file() or path.is_symlink():
            problems.append(f"missing screenshot {filename}")
        else:
            content = path.read_bytes()
            valid_image = (
                content.startswith(b"\x89PNG\r\n\x1a\n")
                or content.startswith(b"\xff\xd8\xff")
                or (content.startswith(b"RIFF") and content[8:12] == b"WEBP")
            )
            if not valid_image:
                problems.append("screenshot is not a PNG, JPEG or WebP image")
            if sums.get(filename) != digest(path):
                problems.append("screenshot missing or mismatched in SHA256SUMS")
            blob = hashlib.sha1(f"blob {len(content)}\0".encode() + content).hexdigest()
            if blob in old_images:
                problems.append(
                    "screenshot reuses pre-build evidence; run a fresh walk"
                )
        if problems:
            errors.append(f"{key}: " + "; ".join(problems))
    return errors, len(expected["rows"])


PACKET = re.compile(r"\b(M\d+[A-Z][A-Z0-9]*|SYM\d+|[SHDI]\d+|P0|J\d*)\b")


def bell(data, diff, ci=False):
    repo = repository(diff["repo"])
    subjects = git(
        repo, "log", "--format=%s", f"{diff['base']}..{diff['head']}"
    ).splitlines()
    packets = {}
    for subject in subjects:
        match = PACKET.search(subject)
        if match:
            packet = match[0].lower()
            packets[packet] = packets.get(packet, False) or bool(
                re.search(r"\bhandoff DONE\b", subject)
            )
    if not packets:
        packets["unassigned"] = False
    failures = []
    for packet, handoff in packets.items():
        checked = diff
        if ci:
            # M3IB: an empty final DONE push still covers earlier packet commits.
            history = git(
                repo, "log", "--reverse", "--format=%H\t%s", diff["head"]
            ).splitlines()
            paths = set()
            for line in history:
                commit, subject = line.split("\t", 1)
                if subject.upper().startswith(packet.upper() + ":"):
                    paths.update(
                        f"{diff['repo']}/{path}"
                        for path in git(repo, "diff-tree", "--root", "-m", "--no-commit-id",
                                        "--name-only", "--no-renames", "-r", "-z", commit).split("\0")
                        if path
                    )
            # Include every packet commit without attributing intervening packets to it.
            checked = dict(diff, packet_paths=sorted(paths))
        result = impact(data, [checked])
        result["labels"] = {
            r["id"]: r["label"]
            for r in sorted(data["rows"], key=lambda r: not r.get("protected"))
            if r["id"] in result["affected"]
        }
        directory = repo / "verification" / packet
        directory.mkdir(parents=True, exist_ok=True)
        (directory / "impacted.json").write_text(
            json.dumps(result, ensure_ascii=False, indent=2) + "\n"
        )
        print(f"Impact bell: {packet.upper()} -> {directory / 'impacted.json'}")
        for key, label in result["labels"].items():
            mark = " [PROTECTED: flagged corner only]" if key in result["protected"] else ""
            print(f"  {key}: {label}{mark}")
        for path in result["unmapped"]:
            print(f"  Unmapped: {path} (add a row or declare no feature impact)")
        # v2.121: BLACK files need a word from the owner or the gate before they change.
        black = re.compile(
            r"(^|/)(docs/SPEC\.md|AXIOMS\.md|CLAUDE\.md|AGENTS\.md|\.github/workflows/[^/]+\.ya?ml)$"
        )
        changed = {p for paths in result["affected"].values() for p in paths} | set(result["unmapped"])
        for path in sorted(changed):
            if black.search(path):
                print(f"  [BLACK: needs a word] {path}")
        if ci:
            evidence_dirs = [directory] if FROZEN else [
                WORKSPACE / name / "verification" / packet
                for name in ("garden", "harness", "spine")
            ]
            evidence_dirs = [
                p for p in evidence_dirs if (p / "ledger-report.json").is_file()
            ]
            canonical = GARDEN / "verification" / packet
            if not FROZEN and canonical in evidence_dirs:
                evidence_dirs = [canonical]
            if len(evidence_dirs) > 1:
                raise ValueError(
                    f"{packet}: multiple ledger reports; keep one authoritative evidence folder"
                )
            try:
                errors, count = verify(
                    data, evidence_dirs[0] if evidence_dirs else directory, [checked]
                )
            except (
                OSError,
                ValueError,
                KeyError,
                TypeError,
                subprocess.CalledProcessError,
            ) as exc:
                errors, count = [str(exc)], len(result["required"])
            if errors:
                print("\n".join(errors))
                if handoff:
                    failures.append(
                        f"{packet.upper()} handoff REFUSED: {count} required rows checked"
                    )
                else:
                    print("Work in progress: evidence is required at the DONE handoff.")
            else:
                print(f"Ledger coverage PASS: {count} required rows")
    if failures:
        raise ValueError("\n".join(failures))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("validate")
    sub.add_parser("render")
    make = sub.add_parser(
        "report", help="stdout is ledger-report.json; no diff means full scout"
    )
    make.add_argument("packet")
    make.add_argument("--diff", action="append", default=[])
    changed = sub.add_parser("impacted")
    changed.add_argument("range", nargs="?")
    changed.add_argument("--paths", nargs="+")
    changed.add_argument("--repo", choices=("harness", "spine", "garden"))
    for command in ("push", "ci"):
        bell_parser = sub.add_parser(command)
        bell_parser.add_argument("range")
        bell_parser.add_argument(
            "--repo", required=True, choices=("harness", "spine", "garden")
        )
    for command in ("verify", "done"):
        check = sub.add_parser(command)
        check.add_argument("packet_dir", type=Path)
        if command == "done":
            check.add_argument(
                "--handoff",
                required=True,
                help="existing report path relative to garden",
            )
    args = parser.parse_args()
    try:
        data = load_ledger()
        if args.command == "render":
            SOURCE.with_suffix(".md").write_text(render(data), encoding="utf-8")
        elif args.command == "validate":
            if not FROZEN and SOURCE.with_suffix(".md").read_text() != render(data):
                raise ValueError("generated markdown is stale: run bin/ledger render")
            print(
                f"Ledger valid: {len(data['rows'])} rows; {sum(r['status'] in {'built', 'partial'} for r in data['rows'])} built/partial"
            )
        elif args.command == "report":
            print(
                json.dumps(
                    report(data, args.packet, [resolve_diff(d) for d in args.diff]),
                    ensure_ascii=False,
                    indent=2,
                )
            )
        elif args.command == "impacted":
            if bool(args.range) == bool(args.paths):
                raise ValueError("choose a diff range or --paths")
            result = impact(
                data,
                [resolve_diff(args.range, args.repo)] if args.range else [],
                args.paths or [],
            )
            result["labels"] = {
                r["id"]: r["label"]
                for r in data["rows"]
                if r["id"] in result["affected"]
            }
            result["warning"] = (
                "add a row or declare no feature impact" if result["unmapped"] else ""
            )
            print(json.dumps(result, ensure_ascii=False, indent=2))
        elif args.command in {"push", "ci"}:
            if not FROZEN and SOURCE.with_suffix(".md").read_text() != render(data):
                raise ValueError("generated markdown is stale: run bin/ledger render")
            bell(data, resolve_diff(args.range, args.repo), ci=args.command == "ci")
        else:
            errors, count = verify(data, args.packet_dir)
            if errors:
                raise ValueError(
                    "\n".join(errors)
                    + f"\nHandoff REFUSED: {count} required rows checked"
                )
            if args.command == "done":
                packet = args.packet_dir.name.upper()
                if not safe_path(args.handoff) or not (GARDEN / args.handoff).is_file():
                    raise ValueError("write the handoff report before marking DONE")
                board = GARDEN / "BOARD.md"
                lines = board.read_text().splitlines(keepends=True)
                found = False
                for i, line in enumerate(lines):
                    cells = line.split("|")
                    if len(cells) == 8 and cells[1].strip() == packet:
                        if cells[4].strip() != "IN_PROGRESS":
                            raise ValueError(
                                f"{packet} must be IN_PROGRESS before handoff"
                            )
                        cells[4] = " DONE "
                        cells[6] = (
                            f" {args.handoff}; ledger coverage PASS ({count} rows) "
                        )
                        lines[i] = "|".join(cells)
                        found = True
                        break
                if not found:
                    raise ValueError(f"{packet}: no claimed board row")
                board.write_text("".join(lines))
            print(
                f"Ledger coverage PASS: {count} required rows; verdicts, screenshots and hashes verified"
            )
    except (
        OSError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.CalledProcessError,
    ) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
