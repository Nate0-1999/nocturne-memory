#!/bin/sh
# M3IB: every push rings; only the CI handoff verifier may block it.
root=$(git rev-parse --show-toplevel)
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    python3 "$root/bin/ledger" push --repo spine "origin/main..$local_sha" ||
        printf '%s\n' 'Impact bell could not run; restore the frozen ledger and tool before handoff.' >&2
done
exit 0
